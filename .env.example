# Stripe API Keys (Get these from your Stripe Dashboard -> Developers -> API Keys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs for Subscription Plans
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# Stripe Webhook Secret (From Stripe Dashboard -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL (Change to your live production domain when deploying, e.g. https://auditflow.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
